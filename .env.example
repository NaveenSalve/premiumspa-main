# ---- Production (Supabase) database connection ----
# SERVER-SIDE ONLY. Keep DATABASE_URL, JWT_SECRET and ADMIN_PIN out of any
# client/frontend code and out of Git. .env is gitignored.
#
# PREFERRED for this backend (single shared pg Pool): Supabase TRANSACTION
# POOLER. Example:
#   DATABASE_URL="postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Port 6543 = transaction pooler (Supavisor), recommended for pooled backends.
#   Port 5432  = direct connection (feature-complete, but capped at ~60 conns
#                per project / fewer per region IP on lower plans).
# A Session Pooler (port 5432, same pooler host, NO pgbouncer param) pins one
# connection per backend instance and is NOT recommended for pg Pool.
#
# If DATABASE_URL is unset the server falls back to discrete SQL_* vars below.

# ---- Supabase / managed PostgreSQL connection string ----
DATABASE_URL=""

# ---- Supabase Storage (optional locally, required for persistent uploads) ----
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY enable server-side image upload to
# the public spa-images bucket. Leave blank for local fallback storage.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

# ---- Pool tuning (optional, sane defaults below) ----
# Max simultaneous connections held by the backend pool (per instance).
DB_POOL_MAX=10
# Close pooled connections idle longer than this (ms).
DB_POOL_IDLE_MS=10000
# Max time to establish a connection / acquire from the queue (ms).
DB_CONNECT_TIMEOUT_MS=10000
# Max ms an individual query may run before it is aborted.
DB_QUERY_TIMEOUT_MS=15000
DB_STATEMENT_TIMEOUT_MS=10000

# ---- Fallback: local / self-managed PostgreSQL (dev) ----
SQL_HOST="127.0.0.1"
SQL_PORT="5432"
SQL_DB_NAME="spa"
SQL_USER="postgres"
SQL_PASSWORD=""
# Force TLS when connecting via SQL_* (managed Postgres, self-hosted with SSL).
SQL_SSL="false"
# Admin credentials only used by drizzle-kit generate/push/migrate.
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD=""

# ---- App secrets (server-side only) ----
# JWT_SECRET: REQUIRED in production; server refuses to boot without it.
JWT_SECRET="your-jwt-secret-key"
# ADMIN_PIN: seeds/rotates the hashed admin login. In PRODUCTION the server
# refuses to start unless the PIN is strong: at least 12 characters spanning at
# least three of lowercase / uppercase / digits / symbols (never log the PIN).
ADMIN_PIN="1234"

# ---- Trusted reverse proxy (F-01) ----
# Controls whether client-supplied X-Forwarded-For is honored. Default (unset/
# "false") trusts NO proxy: rate limits key on the socket remote address, which
# clients cannot spoof — the correct setting for a directly-exposed server.
# If and only if a real proxy (Cloudflare/Nginx/ALB/Railway/Vercel) fronts the
# app, set this to that proxy's IP or CIDR so the real client IP is seen:
#   TRUST_PROXY="10.0.0.0/8"
#   TRUST_PROXY="1.2.3.4,10.0.0.0/8"
# "true" = trust one proxy hop (equivalent to the old trust proxy=1).
TRUST_PROXY="false"

# ---- Strict Origin allowlist (F-08) ----
# Comma/space-separated list of the OFFICIAL origin(s) the production site is
# served from. Browsers send an Origin header on every same-origin state-changing
# request; any POST/PATCH/PUT/DELETE whose Origin is NOT on this list is rejected
# with 403 (no wildcards). REQUIRED in production — if it is unset, all browser
# state-changing requests are rejected (fail-closed). Include both apex and
# www if both are used:
#   APP_ORIGIN="https://your-domain.com,https://www.your-domain.com"
# Cloudflare deployment: set this to the public HTTPS origin (not the origin IP).
APP_ORIGIN=""

# ---- Public Google integrations (client-side, non-secret) ----
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave blank to disable.
VITE_GA_MEASUREMENT_ID=""
# Google Search Console HTML meta verification token. Leave blank until Google gives it.
VITE_GOOGLE_SITE_VERIFICATION=""

# ---- Test-only ----
# Set RATE_LIMIT_DISABLED=1 ONLY in isolated load-test environments to bypass
# auth/booking/message rate limiters. Never enable in production.
RATE_LIMIT_DISABLED="0"
